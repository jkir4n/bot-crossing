[Service]
# Home Assistant solar/battery poller for the colony (server/ha-solar.mjs).
# Operator environment, never the repo: copy this template to
# ~/.config/systemd/user/bot-crossing.service.d/ha.conf and fill in YOUR values,
# then `systemctl --user restart bot-crossing.service`.
#
# HA_BASE_URL and HA_TOKEN are required. Every entity ID is operator-supplied:
# there are NO compiled-in defaults (source contains no house-specific names).
# Entities not configured are simply not polled; their SolarState fields stay
# null and the UI shows a neutral tile. Verify entity IDs against YOUR HA
# (Developer Tools -> States).

# HA REST root, no trailing slash (example: http://homeassistant.local:8123)
Environment=HA_BASE_URL=
# Long-lived access token (HA profile -> Security -> Long-lived access tokens)
Environment=HA_TOKEN=

# Solar production now, in W
Environment=HA_SOLAR_POWER_ENTITY=sensor.my_solar_production_w
# Battery state of charge, in %
Environment=HA_BATTERY_SOC_ENTITY=sensor.my_battery_soc
# Battery power, in W, NEGATIVE = discharging
Environment=HA_BATTERY_POWER_ENTITY=sensor.my_battery_power_w
# Day/night ground truth via elevation attribute
Environment=HA_SUN_ENTITY=sun.sun
# OPTIONAL grid/mode entity: EITHER a mode entity whose state names the source
# (solar|battery|grid, incl. mains|utility|bypass — e.g. sensor.my_source_mode)
# OR a grid-input switch/binary sensor with the explicit binary mapping
# on => grid (grid connected), off => battery (house on own power)
# (e.g. switch.my_grid_input). Numeric grid watts do NOT map — source stays
# null rather than guessed. Empty (default) disables source.
#Environment=HA_GRID_ENTITY=switch.my_grid_input
# Grid threshold pass-through, in %: battery cut-out SoC and cut-in SoC.
# Optional — omit and the readout simply hides the cutoff/cutIn pair.
#Environment=HA_CUTOFF_ENTITY=number.my_grid_connect_soc_threshold
#Environment=HA_CUTIN_ENTITY=number.my_grid_disconnect_soc_threshold

# Poll cadence (~60s), per-request timeout, failures before stale:true
Environment=HA_POLL_MS=60000
# Recorder window (hours) for the OPTIONAL solar.history[] proxy: raw
# /api/history/period samples for the tile entities, passed through verbatim
# (no colony-side shaping). 0 disables -> history key absent. Keep small:
# noisy power entities return hundreds of rows/hour.
Environment=HA_HISTORY_HOURS=1
#Environment=HA_TIMEOUT_MS=5000
#Environment=HA_STALE_AFTER=2
# isDay fallback hysteresis in W, used only if the sun entity is unavailable
#Environment=HA_SOLAR_DAY_ON_W=20
#Environment=HA_SOLAR_DAY_OFF_W=15
