[Service]
# Home Assistant solar/battery poller for the colony (server/ha-solar.mjs).
# Operator environment, never the repo: copy this template to
# ~/.config/systemd/user/bot-crossing.service.d/ha.conf and fill in YOUR values,
# then `systemctl --user restart bot-crossing.service`.
#
# Entity IDs below are the verified defaults compiled into ha-solar.mjs — only
# set the overrides you actually renamed in HA.

# HA REST root, no trailing slash (example: http://homeassistant.local:8123)
Environment=HA_BASE_URL=
# Long-lived access token (HA profile -> Security -> Long-lived access tokens)
Environment=HA_TOKEN=

# Solar production now, in W (default: sensor.power_production_now)
#Environment=HA_SOLAR_POWER_ENTITY=
# Battery state of charge, in % (default: sensor.stair_room_jk_bms_jk_bms_state_of_charge)
#Environment=HA_BATTERY_SOC_ENTITY=
# Battery power, in W, NEGATIVE = discharging (default: sensor.jk_bms_jk_bms_power)
#Environment=HA_BATTERY_POWER_ENTITY=
# Day/night ground truth via elevation attribute (default: sun.sun)
#Environment=HA_SUN_ENTITY=
# OPTIONAL grid/mode entity: its state must read solar|battery|grid (or
# mains|utility|bypass). Numeric grid watts do NOT map — source stays null
# rather than guessed. Empty (default) disables source.
#Environment=HA_GRID_ENTITY=
# Grid threshold pass-through, in % (defaults: number.grid_input_grid_connect_soc_threshold
# = battery cuts OUT at SoC <= cutoff; number.grid_input_grid_disconnect_soc_threshold
# = battery cuts back IN at SoC >= cutIn)
#Environment=HA_CUTOFF_ENTITY=
#Environment=HA_CUTIN_ENTITY=

# Poll cadence (~60s), per-request timeout, failures before stale:true
Environment=HA_POLL_MS=60000
#Environment=HA_TIMEOUT_MS=5000
#Environment=HA_STALE_AFTER=2
# isDay fallback hysteresis in W, used only if sun.sun is unavailable
#Environment=HA_SOLAR_DAY_ON_W=20
#Environment=HA_SOLAR_DAY_OFF_W=15
